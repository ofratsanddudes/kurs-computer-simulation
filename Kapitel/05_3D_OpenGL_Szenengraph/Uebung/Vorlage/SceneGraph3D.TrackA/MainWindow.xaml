<Window x:Class="SceneGraph3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sharpGL="clr-namespace:SharpGL.WPF;assembly=SharpGL.WPF"
        Title="SceneGraph3D – Track A: 4-Achs-SCARA mit Parallelgreifer"
        Width="1300" Height="820">

    <DockPanel>
        <!-- Statusleiste -->
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="TxtStatus" Text="Bereit" />
        </StatusBar>

        <!-- Sidebar -->
        <ScrollViewer DockPanel.Dock="Left" Width="300" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <TextBlock Text="Gelenke" FontWeight="Bold" Margin="0,0,0,6" />

                <DockPanel>
                    <TextBlock x:Name="TxtTheta1" DockPanel.Dock="Right" Text="30°" />
                    <TextBlock Text="θ1 Schulter" />
                </DockPanel>
                <Slider x:Name="SliderTheta1" Minimum="-180" Maximum="180" Value="30"
                        ValueChanged="SliderJoint_ValueChanged" />

                <DockPanel>
                    <TextBlock x:Name="TxtTheta2" DockPanel.Dock="Right" Text="-45°" />
                    <TextBlock Text="θ2 Ellenbogen" />
                </DockPanel>
                <Slider x:Name="SliderTheta2" Minimum="-150" Maximum="150" Value="-45"
                        ValueChanged="SliderJoint_ValueChanged" />

                <DockPanel>
                    <TextBlock x:Name="TxtD3" DockPanel.Dock="Right" Text="0.15 m" />
                    <TextBlock Text="d3 Hub" />
                </DockPanel>
                <Slider x:Name="SliderD3" Minimum="0" Maximum="0.45" Value="0.15"
                        ValueChanged="SliderJoint_ValueChanged" />

                <DockPanel>
                    <TextBlock x:Name="TxtTheta4" DockPanel.Dock="Right" Text="0°" />
                    <TextBlock Text="θ4 Handgelenk" />
                </DockPanel>
                <Slider x:Name="SliderTheta4" Minimum="-180" Maximum="180" Value="0"
                        ValueChanged="SliderJoint_ValueChanged" />

                <DockPanel>
                    <TextBlock x:Name="TxtGWidth" DockPanel.Dock="Right" Text="160 mm" />
                    <TextBlock Text="Greiferöffnung g" />
                </DockPanel>
                <Slider x:Name="SliderGWidth" Minimum="0.02" Maximum="0.16" Value="0.16"
                        ValueChanged="SliderJoint_ValueChanged" />

                <TextBlock Text="Teach-In" FontWeight="Bold" Margin="0,14,0,6" />
                <UniformGrid Columns="2">
                    <Button Content="Pose A speichern" Margin="2" Click="BtnSavePoseA_Click" />
                    <Button Content="→ Pose A" Margin="2" Click="BtnGoPoseA_Click" />
                    <Button Content="Pose B speichern" Margin="2" Click="BtnSavePoseB_Click" />
                    <Button Content="→ Pose B" Margin="2" Click="BtnGoPoseB_Click" />
                    <Button Content="→ Home" Margin="2" Click="BtnGoHome_Click" />
                    <Button Content="Stopp" Margin="2" Click="BtnStopMotion_Click" />
                </UniformGrid>
                <Button Content="Pick &amp; Place Zyklus starten" Margin="2,6,2,2" FontWeight="Bold"
                        Click="BtnStartCycle_Click" />
                <Button Content="Werkstück zurücksetzen" Margin="2" Click="BtnResetWorkpiece_Click" />

                <TextBlock Text="TCP-Validierung" FontWeight="Bold" Margin="0,14,0,6" />
                <TextBlock Text="Analytisch:" />
                <TextBlock x:Name="TxtTcpAnalytic" FontFamily="Consolas" />
                <TextBlock Text="Szenengraph:" Margin="0,4,0,0" />
                <TextBlock x:Name="TxtTcpMatrix" FontFamily="Consolas" />
                <TextBlock x:Name="TxtTcpDiff" FontFamily="Consolas" Margin="0,4,0,0" />

                <TextBlock Text="Ansicht" FontWeight="Bold" Margin="0,14,0,6" />
                <UniformGrid Columns="2">
                    <Button Content="Kamera zurücksetzen" Margin="2" Click="BtnResetView_Click" />
                    <Button Content="Gelenke zurücksetzen" Margin="2" Click="BtnResetJoints_Click" />
                </UniformGrid>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"
                           Text="Links ziehen: Orbit · Rechts ziehen: Panning · Mausrad: Zoom" />
            </StackPanel>
        </ScrollViewer>

        <!-- 3D-Ansicht -->
        <sharpGL:OpenGLControl x:Name="OpenGlView"
                               OpenGLInitialized="OpenGlView_OpenGLInitialized"
                               OpenGLDraw="OpenGlView_OpenGLDraw"
                               Resized="OpenGlView_Resized"
                               MouseDown="OpenGlView_MouseDown"
                               MouseMove="OpenGlView_MouseMove"
                               MouseUp="OpenGlView_MouseUp"
                               MouseWheel="OpenGlView_MouseWheel" />
    </DockPanel>
</Window>
