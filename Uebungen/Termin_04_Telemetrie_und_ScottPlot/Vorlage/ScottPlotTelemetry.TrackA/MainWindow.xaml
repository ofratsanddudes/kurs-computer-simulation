<Window x:Class="ScottPlotTelemetry.TrackA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Termin 04 – Track A: Antriebsprüfstand &amp; Schwingungs-Leitstand"
        Height="860" Width="1400"
        Background="#1E1E1E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Kopfzeile: Titel + Bedienung -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Industrieller Antriebsprüfstand – Condition Monitoring" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="ScottPlot 5 · Welford ±3σ · MSAGL · 50 Hz" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStartStop" Content="Pause" Click="BtnStartStop_Click" Margin="0,0,6,0" Padding="12,5"/>
                    <Button Content="Reset" Click="BtnReset_Click" Margin="0,0,16,0" Padding="12,5"/>
                    <Button Content="Schlupf" Click="BtnSlip_Click" Margin="0,0,6,0" Padding="12,5"/>
                    <Button Content="Lagerschaden" Click="BtnBearing_Click" Margin="0,0,6,0" Padding="12,5"/>
                    <Button Content="Überlast" Click="BtnOverload_Click" Padding="12,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Alarm-Badges -->
        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Rows="1" Margin="0,0,0,8">
            <Border x:Name="BadgeSlip" Background="#1B4D1B" CornerRadius="3" Padding="6" Margin="0,0,4,0">
                <TextBlock x:Name="TxtBadgeSlip" Text="MOMENT OK" Foreground="#98FB98" FontWeight="Bold" FontSize="11" TextAlignment="Center"/>
            </Border>
            <Border x:Name="BadgeVib" Background="#1B4D1B" CornerRadius="3" Padding="6" Margin="4,0">
                <TextBlock x:Name="TxtBadgeVib" Text="VIBRATION OK" Foreground="#98FB98" FontWeight="Bold" FontSize="11" TextAlignment="Center"/>
            </Border>
            <Border x:Name="BadgeOverload" Background="#1B4D1B" CornerRadius="3" Padding="6" Margin="4,0,0,0">
                <TextBlock x:Name="TxtBadgeOverload" Text="LEISTUNG OK" Foreground="#98FB98" FontWeight="Bold" FontSize="11" TextAlignment="Center"/>
            </Border>
        </UniformGrid>

        <!-- Panel 1: Zeitbereich n(t), M(t) -->
        <Border Grid.Row="2" Grid.Column="0" Background="#141414" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="0,0,4,4">
            <sp:WpfPlot x:Name="Plot1"/>
        </Border>

        <!-- Panel 2: Kennfeld M über n -->
        <Border Grid.Row="2" Grid.Column="1" Background="#141414" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="4,0,0,4">
            <sp:WpfPlot x:Name="Plot2"/>
        </Border>

        <!-- Panel 3: Vibrations-Histogramm -->
        <Border Grid.Row="3" Grid.Column="0" Background="#141414" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="0,4,4,0">
            <sp:WpfPlot x:Name="Plot3"/>
        </Border>

        <!-- Panel 4: MSAGL-Antriebsstrang (GraphViewer wird im Code an dieses Panel gebunden) -->
        <Border Grid.Row="3" Grid.Column="1" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="4,4,0,0">
            <DockPanel x:Name="GraphHost" LastChildFill="True" ClipToBounds="True"/>
        </Border>

        <!-- Statuszeile -->
        <Border Grid.Row="4" Grid.ColumnSpan="2" Background="#2D2D30" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
            <TextBlock x:Name="TxtFooter" Text="Telemetrie startet …" Foreground="#CCCCCC" FontSize="11" FontFamily="Consolas"/>
        </Border>
    </Grid>
</Window>
