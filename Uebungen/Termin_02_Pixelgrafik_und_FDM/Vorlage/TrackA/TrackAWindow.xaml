<Window x:Class="TrackA.TrackAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FH OÖ - Track A: Server-Blade CPU-Kühler (Robin-FDM)" 
        Height="680" Width="780" Background="#1E1E1E" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dashboard Header -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Server-Blade CPU-Kühler (150 W Quellterm)" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="200x200 Gitter (dx = 0.2 mm) mit Robin-Konvektion an Kühlrippen" Foreground="#A0A0A0" FontSize="12"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="4" Padding="14,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CPU T_max: " Foreground="#FFA500" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtMaxTemp" Text="25.0 °C" Foreground="#FF4500" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Simulations-Canvas -->
        <Border Grid.Row="1" Background="#0A0A0C" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4">
            <Image x:Name="CoolerImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <!-- Steuerung & Slider -->
        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <!-- Zeitschritt Dt -->
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Zeitschritt Δt (dt_krit ≈ 86.7 µs):" Foreground="White" FontSize="11"/>
                        <TextBlock DockPanel.Dock="Right" x:Name="TxtDtValue" Text="70.0 µs (Stabil)" Foreground="#98FB98" FontWeight="Bold" FontSize="11"/>
                    </DockPanel>
                    <Slider x:Name="SliderDt" Minimum="20" Maximum="120" Value="70"
                            IsSnapToTickEnabled="False"
                            ValueChanged="SliderDt_ValueChanged" Margin="0,2,0,8"/>

                    <!-- Simulations-Tempo -->
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Berechnungs-Intensität (Tempo):" Foreground="White" FontSize="11"/>
                        <TextBlock DockPanel.Dock="Right" x:Name="TxtSpeedValue" Text="400 Schritte/Zyklus" Foreground="#87CEFA" FontWeight="Bold" FontSize="11"/>
                    </DockPanel>
                    <Slider x:Name="SliderSpeed" Minimum="50" Maximum="1500" Value="400"
        IsSnapToTickEnabled="False"
        ValueChanged="SliderSpeed_ValueChanged" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Buttons: Pause/Start, Lüfter Toggle, Reset -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnStartStop" Content="Pause" Click="BtnStartStop_Click" 
                            Background="#2E7D32" Foreground="White" FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,0"/>
                    <Button x:Name="BtnToggleFan" Content="Lüfter: NORMAL (250 W/m²K)" Click="BtnToggleFan_Click" 
                            Background="#0E639C" Foreground="White" FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,0"/>
                    <Button Content="Reset" Click="BtnReset_Click" Background="#3E3E42" Foreground="White" Padding="12,7"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>