<Window x:Class="VectorTrussCanvas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Termin 03 - Track A: 2D-CAD Fachwerkträger-Editor" 
        Height="720" Width="1150"
        MinWidth="800" MinHeight="500"
        Background="#1E1E1E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="2D-CAD Fachwerkträger-Editor" 
                               FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Systemsimulation / Digitaler Zwilling - Fachhochschule Oberösterreich (Campus Wels)" 
                               FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Modell:" Foreground="#D4D4D4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbModelSelection" Width="230" SelectionChanged="CmbModelSelection_SelectionChanged">
                        <ComboBoxItem Content="Sprint: Dreieck (3 Knoten)" IsSelected="True"/>
                        <ComboBoxItem Content="Track A: Pratt-Träger (8 Knoten)"/>
                        <ComboBoxItem Content="Track A: Auslegerkran (10 Knoten)"/>
                    </ComboBox>
                    <Button x:Name="BtnReset" Content="Reset" Click="BtnReset_Click" Margin="8,0,0,0" Padding="12,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Hauptbereich: Canvas + Seitenleiste ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- Zeichenfläche. ClipToBounds schneidet herausgezoomte Elemente sauber ab. -->
            <Border Grid.Column="0" Background="#141414" CornerRadius="4" 
                    BorderBrush="#3F3F46" BorderThickness="1" ClipToBounds="True">
                <Canvas x:Name="TrussCanvas" 
                        Background="Transparent"
                        SizeChanged="TrussCanvas_SizeChanged"
                        MouseDown="TrussCanvas_MouseDown"
                        MouseMove="TrussCanvas_MouseMove"
                        MouseUp="TrussCanvas_MouseUp"
                        MouseWheel="TrussCanvas_MouseWheel"/>
            </Border>

            <!-- Seitenleiste -->
            <Border Grid.Column="1" Background="#2D2D30" CornerRadius="4" Padding="12" Margin="10,0,0,0">
                <StackPanel>

                    <!-- Lastvektor-Editor -->
                    <TextBlock Text="Lastvektor-Editor" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtSelectedNode" Text="Kein Knoten ausgewählt" 
                               Foreground="#9CDCFE" FontSize="12" Margin="0,6,0,10" TextWrapping="Wrap"/>

                    <TextBlock x:Name="TxtFx" Text="Fx = 0.0 kN" Foreground="#D4D4D4" FontSize="12"/>
                    <Slider x:Name="SldFx" Minimum="-100" Maximum="100" Value="0"
                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                            SmallChange="0.5" LargeChange="5" IsEnabled="False"
                            ValueChanged="LoadSlider_ValueChanged" Margin="0,2,0,8"/>

                    <TextBlock x:Name="TxtFy" Text="Fy = 0.0 kN" Foreground="#D4D4D4" FontSize="12"/>
                    <Slider x:Name="SldFy" Minimum="-100" Maximum="100" Value="0"
                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                            SmallChange="0.5" LargeChange="5" IsEnabled="False"
                            ValueChanged="LoadSlider_ValueChanged" Margin="0,2,0,8"/>

                    <TextBlock x:Name="TxtLoadInfo" Text="" Foreground="#CE9178" FontSize="12" 
                               TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Button x:Name="BtnRemoveLoad" Content="Last entfernen" Padding="8,4" 
                            IsEnabled="False" Click="BtnRemoveLoad_Click"/>

                    <Separator Margin="0,14,0,14" Background="#3F3F46"/>

                    <!-- Ansicht -->
                    <TextBlock Text="Ansicht" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Mausrad: Zoom am Mauszeiger&#x0A;Rechte/Mittlere Maustaste ziehen: Verschieben&#x0A;Linke Maustaste: Knoten wählen und ziehen" 
                               Foreground="#AAAAAA" FontSize="11" Margin="0,6,0,8" TextWrapping="Wrap"/>
                    <Button x:Name="BtnResetView" Content="Ansicht zurücksetzen" Padding="8,4" Click="BtnResetView_Click"/>

                    <Separator Margin="0,14,0,14" Background="#3F3F46"/>

                    <!-- JSON -->
                    <TextBlock Text="Datei" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <Button x:Name="BtnSaveJson" Content="JSON Speichern" Padding="8,4" Margin="0,8,0,6" Click="BtnSaveJson_Click"/>
                    <Button x:Name="BtnLoadJson" Content="JSON Laden" Padding="8,4" Click="BtnLoadJson_Click"/>

                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Statusleiste ================= -->
        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtInfo" Text="Knoten anklicken und ziehen. Auto-Fit aktiv." 
                           Foreground="#9CDCFE" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Reine Vektorgrafik (Keine Statik / Keine FEM)" 
                           Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
